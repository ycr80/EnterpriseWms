<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="InventoryReportDataSet" targetNamespace="http://tempuri.org/InventoryReportDataSet.xsd" xmlns:mstns="http://tempuri.org/InventoryReportDataSet.xsd" xmlns="http://tempuri.org/InventoryReportDataSet.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
  <xs:element name="InventoryReportDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
